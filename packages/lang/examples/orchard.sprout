# Earn research money with the starter, then grow a perennial orchard.
unlock berry
unlock hive
if not unlocked(berry) or not unlocked(hive):
    say "Research berry and hive first (700 coins total)."
    stop
go_to 2, 1
if scan().empty:
    build hive
repeat forever:
    for each tile in [{x: 1, y: 1}, {x: 3, y: 1}, {x: 2, y: 2}]:
        go_to tile
        if scan().empty:
            till
            plant berry
        if scan().ripe:
            harvest
    go_to 2, 1
    harvest
    go_to barn
    deposit
    sell berry, all
    sell honey, all
    wait 200
