---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import DownloadCta from '../components/DownloadCta.astro';
import CropTable from '../components/CropTable.astro';
import { sprout } from '../sprout-lang';
import starter from '../../../lang/examples/starter.sprout?raw';
import composter from '../../../lang/examples/compost.sprout?raw';
---
<Base>
  <section class="hero wrap">
    <div class="pitch">
      <h1>A farm you grow by writing code.</h1>
      <p class="lede">Write one program in Sprout, a plain-English language, and every bot on your farm runs it.</p>
      <div class="today" data-today aria-live="polite">
        <p class="eyebrow">Today's farm <span data-num>#…</span></p>
        <p class="facts"><span><strong data-players>–</strong> players</span> <span>Score to beat <strong data-best>–</strong></span> <span data-left></span></p>
        <p class="mods" data-mods hidden></p>
        <div class="mkt" data-market hidden>
          <p data-market-text></p>
          <ul data-market-rows></ul>
          <a href="/docs/market/">How the market works</a>
        </div>
        <a class="btn primary" href="/play/?mode=daily">Play today's farm</a>
      </div>
      <DownloadCta />
      <p class="note">Free on Windows, macOS and Linux. No account needed to play.</p>
    </div>
    <figure class="live">
      <video class="replay" src="/hero-replay.webm" autoplay muted loop playsinline preload="metadata" aria-label="A replay of a daily farm being run by a Sprout program"></video>
      <figcaption>A recorded replay of a daily farm. Each move is played back by the same rules the server uses.</figcaption>
    </figure>
  </section>

  <nav class="wrap paths" aria-label="Where to go">
    <a href="/play/?mode=daily"><b>Play</b><span>Today's farm, ten minutes, ranked</span></a>
    <a href="/docs/sprout/"><b>Learn</b><span>Sprout in ten minutes, then the reference</span></a>
    <a href="/leaderboard/"><b>Compete</b><span>Every score replayed and checked</span></a>
    <a href="/duel/"><b>Race a friend</b><span>Same farm, same seed, no account</span></a>
  </nav>

  <section class="wrap column">
    <h2>Write one program for every bot</h2>
    <p>
      There is no clicking on tiles. You write one program in Sprout, and every bot you own runs it. Bots walk,
      check the soil, plant what they can carry, and haul the harvest back to the barn.
    </p>
    <p>This is the program every new farm starts with. It already makes money. Making it make more is the game.</p>
    <div class="code"><Code code={starter.trim()} lang={sprout as any} themes={{ light: 'github-light', dark: 'github-dark-dimmed' }} defaultColor={false} /></div>
    <p><a href="/docs/sprout/">Learn Sprout in ten minutes</a></p>
  </section>

  <section class="wrap column">
    <h2>Grow without a ceiling</h2>
    <p>
      Land comes in 8 by 8 plots and there is always another one next door. Each plot and each bot costs more
      than the last, so past a point the only way to grow faster is a smarter program.
    </p>
    <p>
      Hives make honey and pollinate the crops around them. Composters turn spare crops back into soil, so the same
      tile keeps producing. Both are a few lines of Sprout:
    </p>
    <div class="code"><Code code={composter.trim()} lang={sprout as any} themes={{ light: 'github-light', dark: 'github-dark-dimmed' }} defaultColor={false} /></div>
  </section>

  <section class="wrap column">
    <h2>Six crops, one soil</h2>
    <p>
      Every crop drinks water, eats nitrogen and tires the ground. Clover puts nitrogen back. Berries and apples
      regrow after harvest. Carrots and pumpkins die if frost arrives before they ripen, and the forecast is one
      call away.
    </p>
    <CropTable />
    <p><a href="/docs/how-to-play/#crops">More on crops and soil</a></p>
  </section>

  <section class="wrap column">
    <h2>How a score reaches the leaderboard</h2>
    <p>
      Your program runs on your own machine, so it can be as clever as you like. What reaches the leaderboard is the
      list of moves it made. The server plays those moves back through the same rules and never sees your code. A
      doctored save doesn't match, so it doesn't count.
    </p>
    <p><a href="/docs/leaderboard/">How the leaderboard stays fair</a></p>
  </section>

  <section class="wrap closing column">
    <h2>Try it with one plot</h2>
    <p>The starter program farms it for you. What happens after that is up to you.</p>
    <DownloadCta />
  </section>
</Base>

<script>
  import { api, fmt, marketOf, modifiersOf, msUntil, timeLeft } from '../scripts/arena';
  import type { Challenge } from '../scripts/arena';
  const root = document.querySelector<HTMLElement>('[data-today]')!;
  const q = (s: string) => root.querySelector<HTMLElement>(s)!;
  void api<Challenge>('/challenges/today').then((c) => {
    if (!c) { q('[data-num]').textContent = ''; q('.facts').textContent = 'A new farm every day, the same for everyone.'; return; }
    q('[data-num]').textContent = c.number != null && c.number > 0 ? `#${c.number}` : '(practice)'; // days before the 1 Dec 2026 launch
    q('[data-players]').textContent = fmt.format(c.players);
    q('[data-best]').textContent = c.best == null ? 'none yet' : fmt.format(c.best);
    q('[data-left]').textContent = timeLeft(msUntil(c.closesAt));
    const mods = modifiersOf(c);
    const mk = marketOf(c);
    if (mk) {
      q('[data-market-text]').textContent = mk.text;
      q('[data-market-rows]').replaceChildren(...mk.rows.map((r) => {
        const li = document.createElement('li'); li.className = r.trend;
        li.textContent = `${r.name} ${r.price} (${r.change})`; return li;
      }));
      q('[data-market]').hidden = false;
    }
    if (mods.length) { const m = q('[data-mods]'); m.textContent = `Today's twist: ${mods.join(' · ')}`; m.hidden = false; }
  });
</script>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; padding-block: clamp(2.5rem, 7vw, 5.5rem) 3rem; }
  .hero h1 { max-width: 14ch; }
  .lede { font-size: 1.25rem; color: var(--dim); margin: 1.1rem 0 1.6rem; max-width: 32rem; }
  .today { border-top: 1px solid var(--rule); border-bottom: 1px solid var(--line); padding: 0.9rem 0 1rem; margin: 0 0 1.25rem; max-width: 34rem; }
  .eyebrow { margin: 0 0 0.3rem; }
  .facts { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; color: var(--dim); margin: 0.3rem 0 0.8rem; font-variant-numeric: tabular-nums; }
  .facts strong { color: var(--ink); font-weight: 700; }
  .mods, .mkt { margin: -0.2rem 0 0.8rem; color: var(--dim); font-size: 0.95rem; }
  .mkt p { margin: 0 0 0.3rem; }
  .mkt ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.2rem 0.9rem; padding: 0; margin: 0 0 0.3rem; font-variant-numeric: tabular-nums; }
  .mkt li { text-transform: capitalize; }
  .note { color: var(--dim); font-size: 0.95rem; margin: 0.9rem 0 0; }
  .live { margin: 0; }
  .replay { width: 100%; aspect-ratio: 2 / 1; object-fit: cover; border: 1px solid var(--line); border-radius: 2px; background: var(--code-bg); }
  .live figcaption { color: var(--dim); font-size: 0.92rem; margin: 0.6rem 0 0; max-width: 36rem; }
  section + section { margin-top: clamp(3.5rem, 8vw, 6rem); }
  .paths { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 0 1.5rem; margin: 0 auto 3rem; border-top: 1px solid var(--rule); }
  .paths a { display: grid; gap: 0.2rem; padding: 0.9rem 0 0.9rem; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .paths a:hover b { text-decoration: underline; text-decoration-color: var(--carrot); text-decoration-thickness: 2px; text-underline-offset: 0.25em; }
  .paths b { font: 600 1.15rem var(--display); text-transform: uppercase; letter-spacing: 0.08em; }
  .paths span { color: var(--dim); font-size: 0.95rem; }
  .column { max-width: 42rem; }
  .column h2 { margin-bottom: 1rem; }
  .column > p { font-size: 1.08rem; margin: 0 0 1rem; }
  .column > p:has(+ .code) { margin-bottom: 1.25rem; }
  .column > .code { margin: 0 0 1.25rem; }
  .code :global(pre) { margin: 0; font-size: 0.86rem; }
  .closing { border-top: 1px solid var(--line); padding-top: 3rem; }
  .closing p { color: var(--dim); font-size: 1.1rem; margin: 0 0 1.5rem; }
  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
  }
</style>
