---
import Base from '../layouts/Base.astro';
---
<Base title="Player" description="A Tendril player's streak, medals and recent daily farms.">
  <section class="wrap page">
    <p class="state" data-state>Loading…</p>
    <div data-profile hidden>
      <header class="who">
        <img data-avatar alt="" width="72" height="72" hidden />
        <div>
          <h1 data-name></h1>
          <p class="lede" data-login></p>
        </div>
      </header>
      <dl class="stats">
        <div><dt>Current streak</dt><dd data-streak>0</dd></div>
        <div><dt>Best streak</dt><dd data-best>0</dd></div>
        <div><dt>Wealth medals</dt><dd data-m-wealth>0</dd></div>
        <div><dt>Speed medals</dt><dd data-m-speed>0</dd></div>
        <div><dt>Brevity medals</dt><dd data-m-brevity>0</dd></div>
      </dl>
      <h2>Recent entries</h2>
      <p class="state" data-empty hidden>No entries yet.</p>
      <ul class="recent" role="list" data-recent></ul>
    </div>
  </section>
</Base>

<script>
  import { api, arenaCss, el, fmt, mosaicEl } from '../scripts/arena';

  interface Recent { entryId?: string; id?: string; challengeId?: string; challenge?: string; number?: number; netWorth?: number; mosaic?: string | null; createdAt?: string | number; date?: string }
  interface Profile {
    login: string; displayName?: string; avatarUrl?: string; streak?: number; bestStreak?: number;
    medals?: Partial<Record<'wealth' | 'speed' | 'brevity', number>>; recent?: Recent[];
  }

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const state = $('[data-state]');
  const style = document.createElement('style');
  style.textContent = arenaCss;
  document.head.append(style);

  const login = new URLSearchParams(location.search).get('login')?.trim() ?? '';
  async function main() {
    if (!/^[A-Za-z0-9-]{1,39}$/.test(login)) { state.textContent = 'No player chosen. Open a name from the leaderboard.'; return; }
    const p = await api<Profile>(`/players/${encodeURIComponent(login)}`);
    if (!p) { state.textContent = `Profiles for ${login} aren't available yet. Check back soon.`; return; }
    document.title = `${p.displayName || p.login} | Tendril`;
    state.hidden = true;
    $('[data-profile]').hidden = false;
    $('[data-name]').textContent = p.displayName || p.login;
    $('[data-login]').textContent = `@${p.login}`;
    if (p.avatarUrl && /^https:\/\//.test(p.avatarUrl)) { const a = $<HTMLImageElement>('[data-avatar]'); a.src = p.avatarUrl; a.hidden = false; }
    $('[data-streak]').textContent = fmt.format(p.streak ?? 0);
    $('[data-best]').textContent = fmt.format(p.bestStreak ?? 0);
    for (const m of ['wealth', 'speed', 'brevity'] as const) $(`[data-m-${m}]`).textContent = fmt.format(p.medals?.[m] ?? 0);
    const list = $('[data-recent]');
    const recent = p.recent ?? [];
    $('[data-empty]').hidden = recent.length > 0;
    for (const r of recent) {
      const id = r.entryId ?? r.id;
      const li = el('li', 'entry');
      const pic = mosaicEl(r.mosaic, '3.5rem');
      if (pic) li.append(pic);
      const label = r.number != null ? `Daily #${r.number}` : r.challengeId ?? r.challenge ?? r.date ?? 'Entry';
      const t = el('div');
      t.append(el('strong', undefined, label));
      if (r.netWorth != null) t.append(el('br'), el('span', 'dim', `${fmt.format(r.netWorth)} net worth`));
      li.append(t);
      if (id) { const a = el('a', undefined, 'Replay'); a.href = `/r/${encodeURIComponent(id)}`; li.append(a); }
      list.append(li);
    }
  }
  void main();
</script>

<style is:global>
  .page { padding-top: clamp(2.5rem, 6vw, 4.5rem); max-width: 52rem; }
  .state { color: var(--dim); padding: 1.5rem 0; }
  .dim { color: var(--dim); }
  .who { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; }
  .who img { border-radius: 50%; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr)); gap: 1rem; margin: 0 0 2.5rem; }
  .stats div { border: 1.5px solid var(--line); border-radius: 10px; padding: 0.8rem 1rem; }
  .stats dt { color: var(--dim); font-size: 0.88rem; }
  .stats dd { margin: 0; font: 700 1.9rem var(--display); }
  .recent { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.75rem; }
  .entry { display: flex; align-items: center; gap: 0.9rem; border-bottom: 1px solid var(--line); padding-bottom: 0.75rem; }
  .entry a { margin-left: auto; }
</style>
