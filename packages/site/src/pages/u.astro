---
import Base from '../layouts/Base.astro';
import Portfolio from '../components/Portfolio.astro';
---
<Base title="Player" description="A Tendril player's rating, tier, rating history, medals and recent daily farms. Every rating point links to a replay.">
  <Portfolio />
</Base>

<script>
  import { initPortfolio } from '../scripts/portfolio';
  const root = document.querySelector<HTMLElement>('[data-pf]');
  if (root) void initPortfolio(root);
</script>
