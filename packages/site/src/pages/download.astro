---
import Base from '../layouts/Base.astro';
import { PLATFORMS, RELEASE, released } from '../data/downloads';
---
<Base title="Download" description="Download Tendril for Windows, macOS or Linux.">
  <section class="wrap page">
    <h1>Download Tendril</h1>
    <p class="lede">
      {released
        ? `Version ${RELEASE.version}, ${RELEASE.channel.toLowerCase()}. Pick your system below.`
        : 'Installers for all three systems will be posted here with the first early-access build. Until then, the whole game runs in your browser.'}
    </p>

    {!released && <p class="now"><a class="btn primary" href="/play/">Play in browser</a></p>}

    <ul class="platforms" role="list">
      {PLATFORMS.map((p) => (
        <li class="platform" data-os={p.os}>
          <h2>{p.name}</h2>
          <p class="req">{p.requirements}</p>
          <ul class="builds" role="list">
            {p.builds.map((b) => (
              <li>
                {b.url
                  ? <a class="btn primary" href={b.url} download>{b.label}<small>{b.size ?? b.file}</small></a>
                  : <span class="btn" aria-disabled="true">{b.label}<small>Coming soon</small></span>}
                {b.sha256 && <code class="sha" title="SHA-256">{b.sha256}</code>}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>

    <div class="after">
      <section>
        <h2>After you install</h2>
        <p>
          Open Tendril and you start with one plot, one bot and a starter program that already farms.
          Press Run, watch it work, then start changing it. <a href="/docs/">Getting started</a> walks through your first ten minutes.
        </p>
      </section>
      <section>
        <h2>First launch warnings</h2>
        <p>Early builds may not be signed yet, so your system can ask before opening them.</p>
        <ul>
          <li><b>Windows:</b> if SmartScreen appears, choose More info, then Run anyway.</li>
          <li><b>macOS:</b> if macOS blocks the app, open System Settings, Privacy &amp; Security, and choose Open Anyway.</li>
          <li><b>Linux:</b> make the AppImage executable with <code>chmod +x Tendril.AppImage</code>, then run it.</li>
        </ul>
      </section>
    </div>
  </section>
</Base>
<script>
  const ua = navigator.userAgent;
  const os = /Windows/i.test(ua) ? 'windows' : /Mac OS X|Macintosh/i.test(ua) ? 'mac' : /Linux|X11/i.test(ua) ? 'linux' : null;
  const el = os && document.querySelector<HTMLElement>(`.platform[data-os="${os}"]`);
  if (el) { el.classList.add('mine'); el.querySelector('h2')!.insertAdjacentHTML('beforeend', ' <span class="yours">Your system</span>'); }
</script>
<style>
  .page { padding-top: clamp(2.5rem, 6vw, 4.5rem); }
  .lede { font-size: 1.2rem; color: var(--dim); max-width: 40rem; margin: 1rem 0 2.5rem; }
  .now { margin: -1rem 0 2.5rem; }
  .platforms { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .platform { border: 1.5px solid var(--line); border-radius: 14px; padding: 1.5rem; display: flex; flex-direction: column; }
  .platform.mine { border-color: var(--leaf); }
  .platform h2 { font-size: 1.5rem; display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; }
  .platform :global(.yours) { font: 400 0.85rem var(--body); color: var(--leaf); }
  .req { color: var(--dim); font-size: 0.95rem; margin: 0.6rem 0 1.25rem; flex: 1; }
  .builds { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .builds .btn { width: 100%; justify-content: space-between; }
  .sha { display: block; font-size: 0.7rem; color: var(--dim); overflow-wrap: anywhere; margin-top: 0.35rem; }
  .after { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-top: 4rem; }
  .after h2 { font-size: 1.4rem; margin-bottom: 0.75rem; }
  .after p, .after ul { color: var(--ink); max-width: 34rem; }
  .after li { margin-bottom: 0.4rem; }
  @media (max-width: 860px) { .platforms, .after { grid-template-columns: 1fr; } }
</style>
