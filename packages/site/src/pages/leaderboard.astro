---
import Base from '../layouts/Base.astro';
---
<Base title="Leaderboard" description="Today's Tendril farm, this week's season, the endless farm and the rating ladder: boards where every score was proven by replaying the moves on the server.">
  <section class="wrap page">
    <h1>Leaderboard</h1>
    <p class="lede">Every score here was checked by replaying its moves on the server. <a href="/docs/leaderboard/">How that works</a></p>

    <div class="tabs" role="tablist" aria-label="Board" data-scopes>
      <button role="tab" aria-selected="true" data-scope="daily">Daily</button>
      <button role="tab" aria-selected="false" data-scope="week" tabindex="-1">Week</button>
      <button role="tab" aria-selected="false" data-scope="endless" tabindex="-1">Endless</button>
      <button role="tab" aria-selected="false" data-scope="rating" tabindex="-1">Rating</button>
    </div>

    <div class="controls">
      <div class="seg" role="group" aria-label="Medal" data-medals>
        <button data-medal="wealth" aria-pressed="true">Wealth</button>
        <button data-medal="speed" aria-pressed="false">Speed</button>
        <button data-medal="brevity" aria-pressed="false">Brevity</button>
      </div>
      <div class="seg" role="group" aria-label="Who" data-who-group>
        <button data-who="global" aria-pressed="true">Everyone</button>
        <button data-who="friends" aria-pressed="false">Friends</button>
      </div>
      <div class="seg" role="group" aria-label="Author" data-author-group title="Whether a person or an AI model wrote the program. Declared by the entrant; models must publish their program.">
        <button data-author="human" aria-pressed="true">Humans</button>
        <button data-author="model" aria-pressed="false">Models</button>
        <button data-author="all" aria-pressed="false">Both</button>
      </div>
      <div class="seg" role="group" aria-label="Rating discipline" data-rating-group hidden>
        <button data-disc="overall" aria-pressed="true">Overall</button>
        <button data-disc="speed" aria-pressed="false">Speed</button>
        <button data-disc="brevity" aria-pressed="false">Brevity</button>
      </div>
      <div class="seg" role="group" aria-label="Endless board" data-endless hidden>
        <button data-end="networth" aria-pressed="true">Net worth</button>
        <button data-end="growth" aria-pressed="false">Growth today</button>
      </div>
    </div>

    <div id="board" role="tabpanel" aria-live="polite">
      <p class="about" data-about></p>
      <div data-histo></div>
      <div class="table-scroll">
        <table>
          <thead><tr data-head><th class="rank">Rank</th><th>Farmer</th><th class="num" data-col>Net worth</th></tr></thead>
          <tbody data-rows></tbody>
        </table>
      </div>
      <nav class="pager-row" aria-label="Rating pages" data-pager hidden>
        <button type="button" data-prev>Previous</button>
        <span class="dim" data-page></span>
        <button type="button" data-next>Next</button>
      </nav>
      <p class="state" data-state>Loading…</p>
    </div>

    <section class="yesterday" aria-labelledby="yh" data-yesterday hidden>
      <h2 id="yh">Yesterday's winners</h2>
      <ul class="winners" role="list" data-winners></ul>
      <details class="yboard" data-yboard>
        <summary>Full board with rating changes</summary>
        <table>
          <thead><tr><th class="rank">Rank</th><th>Farmer</th><th class="num">Net worth</th></tr></thead>
          <tbody data-yrows></tbody>
        </table>
        <p class="state" data-ystate></p>
      </details>
    </section>

    <section class="hall" aria-labelledby="hf" data-hall hidden>
      <h2 id="hf">Hall of Fame</h2>
      <p class="about" data-hall-about>Closed seasons and the human farmers who took each medal. Models are ranked on the weekly board with the Models filter.</p>
      <ol class="seasons" role="list" data-seasons></ol>
      <p class="state" data-hall-state>Loading…</p>
    </section>

    <section id="programs" aria-labelledby="programs-title">
      <h2 id="programs-title">Published programs</h2>
      <p class="about">Players can choose to share the Sprout program behind a run. They appear here once the challenge has closed, best net worth first. The server ran each one and checked that it produces exactly the moves behind the score.</p>
      <div class="tabs" role="group" aria-label="Closed challenge">
        <button type="button" id="pick-daily" aria-pressed="true">Yesterday's daily</button>
        <button type="button" id="pick-season" aria-pressed="false">Last week's season</button>
      </div>
      <p class="state" data-programs-state>Loading…</p>
      <ul class="programs" data-programs></ul>
      <figure class="program" data-program hidden>
        <figcaption data-program-caption></figcaption>
        <pre class="sprout" tabindex="0" aria-label="Sprout program"><code data-program-code></code></pre>
        <p class="report"><button type="button" data-report>Report this program</button> <span data-report-state role="status"></span></p>
      </figure>
    </section>
  </section>
</Base>

<script>
  import { api, arenaCss, el, fmt, histogramEl, medalValue, MEDALS, mosaicEl, deltaEl, playerLink, timeLeft, msUntil, utcDay } from '../scripts/arena';
  import type { Board, Challenge, Medal, Row, TierRef } from '../scripts/arena';

  type Scope = 'daily' | 'week' | 'endless' | 'rating';
  type Disc = 'overall' | 'speed' | 'brevity';
  type RatingRow = { rank: number; login: string; displayName: string; rating: number; tier: TierRef; events: number; lastRatedAt?: number };
  type GhostStat = { rating: number; tier: TierRef; events: number; humanRank: number };
  type Ghost = GhostStat & { name: string; disciplines?: Partial<Record<Disc, GhostStat | null>> };
  type Season = { id: string; number: number | null; closesAt: number; players: number; winners: Record<Medal, Row | null> };
  type EndRow = { rank: number; displayName: string; netWorth: number; growth24h?: number };

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const rows = $('[data-rows]'), state = $('[data-state]'), about = $('[data-about]'), histo = $('[data-histo]');
  let col = $('[data-col]');
  const scopeTabs = [...document.querySelectorAll<HTMLButtonElement>('[data-scope]')];
  const medalBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-medal]')];
  const whoBtns = [...document.querySelectorAll<HTMLButtonElement>('button[data-who]')];
  const authorBtns = [...document.querySelectorAll<HTMLButtonElement>('button[data-author]')];
  const discBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-disc]')];
  const head = $('[data-head]'), pager = $('[data-pager]'), pageLbl = $('[data-page]');
  const prevBtn = $<HTMLButtonElement>('[data-prev]'), nextBtn = $<HTMLButtonElement>('[data-next]');
  const endBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-end]')];

  const st = { scope: 'daily' as Scope, disc: 'overall' as Disc, medal: 'wealth' as Medal, who: 'global', author: 'human', end: 'networth' };
  if (/^(human|model|all)$/.test(new URLSearchParams(location.search).get('author') ?? '')) st.author = new URLSearchParams(location.search).get('author')!;
  const hash = location.hash.slice(1);
  if (hash === 'daily' || hash === 'week' || hash === 'endless' || hash === 'rating') st.scope = hash;
  let token = 0;

  const style = document.createElement('style');
  style.textContent = arenaCss;
  document.head.append(style);

  function pressed(btns: HTMLButtonElement[], key: string, val: string) {
    for (const b of btns) b.setAttribute('aria-pressed', String(b.dataset[key] === val));
  }

  function fill(cells: (Node | string)[][]) {
    rows.replaceChildren();
    for (const r of cells) {
      const tr = el('tr');
      r.forEach((c, i) => {
        const td = el('td', i === 0 ? 'rank' : i === r.length - 1 ? 'num' : '');
        td.append(c);
        tr.append(td);
      });
      rows.append(tr);
    }
  }

  function farmerCell(r: Row) {
    const wrap = el('span', 'farmer');
    const m = mosaicEl(r.mosaic, '2.25rem');
    if (m) wrap.append(m);
    const name = playerLink(r.login, r.displayName || r.login, r.tier);
    wrap.append(name);
    const d = deltaEl(r.delta, r.rating);
    if (d) wrap.append(d);
    if (r.authorKind === 'model') wrap.append(el('span', 'tag', r.model ? `model: ${r.model}` : 'model'));
    return wrap;
  }

  async function show() {
    const mine = ++token;
    pressed(scopeTabs, 'scope', st.scope);
    scopeTabs.forEach((t) => { t.setAttribute('aria-selected', String(t.dataset.scope === st.scope)); t.tabIndex = t.dataset.scope === st.scope ? 0 : -1; });
    pressed(medalBtns, 'medal', st.medal);
    pressed(whoBtns, 'who', st.who);
    pressed(authorBtns, 'author', st.author);
    pressed(endBtns, 'end', st.end);
    pressed(discBtns, 'disc', st.disc);
    const endless = st.scope === 'endless', ratingTab = st.scope === 'rating';
    $('[data-medals]').hidden = endless || ratingTab;
    $('[data-who-group]').hidden = endless || ratingTab;
    $('[data-author-group]').hidden = endless || ratingTab;
    $('[data-endless]').hidden = !endless;
    $('[data-rating-group]').hidden = !ratingTab;
    rows.classList.toggle('rated', ratingTab);
    pager.hidden = true;
    head.replaceChildren(...(ratingTab ? ['Rank', 'Player', 'Tier', 'Events', 'Rating'] : ['Rank', 'Farmer', endless ? (st.end === 'growth' ? 'Growth' : 'Net worth') : 'Net worth']).map((t, i, a) => {
      const th = el('th', i === 0 ? 'rank' : i === a.length - 1 ? 'num' : '', t);
      if (i === a.length - 1) th.setAttribute('data-col', '');
      return th;
    }));
    col = head.lastElementChild as HTMLElement;
    $('[data-yesterday]').hidden = true;
    $('[data-hall]').hidden = st.scope !== 'week';
    history.replaceState(null, '', `#${st.scope}`);
    rows.replaceChildren();
    histo.replaceChildren();
    state.hidden = false;
    state.textContent = 'Loading…';
    try {
      if (endless) await showEndless(mine); else if (ratingTab) await showRating(mine); else await showChallenge(mine);
      if (st.scope === 'week') void hallOfFame(mine);
    } catch {
      if (mine === token) { about.textContent = ''; state.textContent = "The leaderboard can't be reached right now. Your farm is safe; try again in a minute."; }
    }
  }

  /** Cursor for each page shown so far; cursors[i] fetches page i (the first is empty). */
  let cursors: string[] = [''];
  let page = 0;
  /** Last human rank on each page shown so far, so a ghost lands on exactly one page. */
  const lastRank: number[] = [];
  /** Model ghosts from /ratings/models, fetched once. */
  let ghosts: Ghost[] | null = null;

  async function loadGhosts(): Promise<Ghost[]> {
    if (ghosts) return ghosts;
    try {
      const d = await api<{ models?: Ghost[] }>('/ratings/models');
      if (!d?.models) return [];
      ghosts = d.models;
    } catch { return []; }
    return ghosts;
  }

  /** One ghost row; it sits just before human rank `humanRank` and takes no number. */
  function ghostRow(g: Ghost, s: GhostStat) {
    const tr = el('tr', 'ghost');
    tr.title = "A model, rated on the same scale. It takes no numbered place and does not change any person's rating.";
    const tk = /^[a-z]+$/.test(s.tier.key) ? `tier-${s.tier.key}` : '';
    const name = el('span', tk, `model: ${g.name}`);
    name.style.fontWeight = '600';
    const cells: Node[] = [el('span', 'tag', 'ghost'), name, el('span', tk, `${s.tier.name} level`), document.createTextNode(String(s.events)), document.createTextNode(fmt.format(s.rating))];
    cells.forEach((c, i) => { const td = el('td', i === 0 ? 'rank' : i === cells.length - 1 ? 'num' : ''); td.append(c); tr.append(td); });
    return tr;
  }

  async function showRating(mine: number) {
    about.textContent = `Established players (5 or more rated runs) who played in the last 30 days, highest rating first. Names take the colour of their tier. `;
    about.append(Object.assign(el('a', undefined, 'How rating works'), { href: '/docs/rating/' }), '.');
    const data = await api<{ entries?: RatingRow[]; nextCursor?: string | null }>(`/ratings/board?discipline=${st.disc}&limit=20${cursors[page] ? `&cursor=${encodeURIComponent(cursors[page]!)}` : ''}`);
    if (mine !== token) return;
    if (!data) throw new Error('down');
    const list = data.entries ?? [];
    if (!list.length) {
      state.textContent = page > 0 ? 'No more players on this page.' : 'Nobody is on the ladder yet. Players appear here after 5 rated runs.';
      pager.hidden = page === 0;
      pageLbl.textContent = `Page ${page + 1}`; prevBtn.disabled = page === 0; nextBtn.disabled = true;
      return;
    }
    state.hidden = true;
    fill(list.map((e) => [String(e.rank), playerLink(e.login, e.displayName || e.login, e.tier), el('span', /^[a-z]+$/.test(e.tier.key) ? `tier-${e.tier.key}` : '', e.tier.name), String(e.events), fmt.format(e.rating)]));
    [...rows.children].forEach((tr, i) => { (tr as HTMLElement).dataset.rank = String(list[i]!.rank); if (list[i]!.rank <= 3) tr.classList.add('podium'); });
    const nxt = data.nextCursor ?? null;
    lastRank[page] = list[list.length - 1]!.rank;
    const lo = page > 0 ? (lastRank[page - 1] ?? 0) : 0;
    const placed = (await loadGhosts())
      .map((g) => [g, st.disc === 'overall' ? g : g.disciplines?.[st.disc]] as const)
      .filter((p): p is readonly [Ghost, GhostStat] => !!p[1] && p[1].humanRank > lo && (!nxt || p[1].humanRank <= lastRank[page]!))
      .sort((a, b) => a[1].humanRank - b[1].humanRank || b[1].rating - a[1].rating);
    if (mine !== token) return;
    const trs = [...rows.children] as HTMLElement[];
    for (const [g, s] of placed) {
      const at = trs.find((t) => Number(t.dataset.rank) >= s.humanRank);
      const gr = ghostRow(g, s);
      if (at) at.before(gr); else rows.append(gr);
    }
    if (nxt) cursors[page + 1] = nxt; else cursors = cursors.slice(0, page + 1);
    pager.hidden = page === 0 && !nxt;
    pageLbl.textContent = `Page ${page + 1}`;
    prevBtn.disabled = page === 0;
    nextBtn.disabled = !nxt;
  }

  async function showEndless(mine: number) {
    col.textContent = st.end === 'growth' ? 'Growth' : 'Net worth';
    about.textContent = st.end === 'growth'
      ? "How much each farm's net worth rose in the last 24 hours."
      : 'The real-time farm that never resets: coins, plus everything spent on land, bots, buildings and research, plus barn stock.';
    const data = await api<{ entries?: EndRow[] }>(`/leaderboard?board=${st.end}&limit=50`);
    if (mine !== token) return;
    if (!data) throw new Error('down');
    const list = data.entries ?? [];
    if (!list.length) { state.textContent = 'No farms have been checked yet. Play an Endless farm in the game and yours will be the first.'; return; }
    state.hidden = true;
    fill(list.map((e) => [String(e.rank), e.displayName, st.end === 'growth' ? `${(e.growth24h ?? 0) >= 0 ? '+' : ''}${fmt.format(e.growth24h ?? 0)}` : fmt.format(e.netWorth)]));
  }

  async function showChallenge(mine: number) {
    const id = st.scope === 'week' ? 'week' : 'today';
    col.textContent = st.medal === 'wealth' ? 'Net worth' : st.medal === 'speed' ? 'Par reached' : 'Tokens';
    if (st.who === 'friends' && !(await api('/me'))) {
      if (mine !== token) return;
      about.textContent = '';
      state.replaceChildren('Friends shows the players you follow. ', Object.assign(el('a', undefined, 'Sign in with GitHub'), { href: `/api/auth/github?return=${encodeURIComponent('/leaderboard/')}` }), ' to follow players and see them here.');
      return;
    }
    const [ch, board] = await Promise.all([
      api<Challenge>(`/challenges/${id}`),
      api<Board>(`/challenges/${id}/board?medal=${st.medal}&scope=${st.who}${st.author === 'all' ? '' : `&author=${st.author}`}&limit=50`),
    ]);
    if (mine !== token) return;
    if (!ch || !board) {
      throw new Error('down');
    }
    const num = ch.number != null && ch.number > 0 ? ` #${ch.number}` : ''; // days before the 1 Dec 2026 launch are practice
    const label = `${num ? '' : 'Practice '}${st.scope === 'week' ? 'Season week' : 'Daily'}${num}`;
    about.textContent = `${label}: ${MEDALS[st.medal].blurb} ${ch.players} player${ch.players === 1 ? '' : 's'}, ${timeLeft(msUntil(ch.closesAt))}.`;
    if (!board.entries.length) {
      state.textContent = st.author === 'model' && st.who !== 'friends'
        ? 'No model has entered this one yet. The open harness in examples/agent will play it with any model: see "Humans vs models" in the docs.'
        : st.who === 'friends'
        ? 'None of the players you follow have an entry here yet. Follow players from their profile page, or switch to Everyone.'
        : st.medal === 'brevity'
          ? 'No Brevity scores yet. Token counts arrive with the next game update.'
          : 'No scores yet. Play in the game and yours will be the first.';
      void yesterday();
      return;
    }
    state.hidden = true;
    histo.replaceChildren(histogramEl(board, st.medal));
    const cells = board.entries.map((r) => [String(r.rank), farmerCell(r), medalValue(st.medal, r.value)]);
    if (board.me && !board.entries.some((r) => r.entryId === board.me!.entryId)) {
      cells.push([String(board.me.rank), farmerCell(board.me), medalValue(st.medal, board.me.value)]);
    }
    fill(cells);
    void yesterday();
  }

  async function hallOfFame(mine: number) {
    const hallState = $('[data-hall-state]'), list = $('[data-seasons]');
    list.replaceChildren();
    hallState.hidden = false;
    hallState.textContent = 'Loading…';
    const data = await api<{ seasons: Season[] }>('/seasons?limit=20');
    if (mine !== token) return;
    if (!data) { hallState.textContent = "The Hall of Fame can't be reached right now."; return; }
    if (!data.seasons.length) { hallState.textContent = 'No season has closed yet. The first winners will be listed here when this week ends.'; return; }
    hallState.hidden = true;
    for (const s of data.seasons) {
      const li = el('li', 'season');
      const title = s.number !== null && s.number > 0 ? `Season #${s.number}` : `Practice week ${s.id.slice(2)}`;
      li.append(el('h3', undefined, title), el('p', 'dim', `${s.players} player${s.players === 1 ? '' : 's'}, closed ${new Date(s.closesAt).toISOString().slice(0, 10)}`));
      const medals = el('ul', 'winners');
      for (const m of ['wealth', 'speed', 'brevity'] as Medal[]) {
        const r = s.winners[m];
        if (!r) continue;
        const item = el('li', 'winner');
        const pic = mosaicEl(r.mosaic, '4rem');
        if (pic) item.append(pic);
        const txt = el('div');
        txt.append(el('strong', undefined, MEDALS[m].label), el('br'), playerLink(r.login, r.displayName || r.login, r.tier), el('br'), el('span', 'dim', medalValue(m, r.value)));
        item.append(txt);
        medals.append(item);
      }
      li.append(medals);
      list.append(li);
    }
  }

  async function yesterday() {
    if (st.scope !== 'daily') return;
    const mine = token;
    const id = `d-${utcDay(-1)}`;
    const [ch, w, s, b] = await Promise.all([
      api<Challenge>(`/challenges/${id}`),
      ...(['wealth', 'speed', 'brevity'] as Medal[]).map((m) => api<Board>(`/challenges/${id}/board?medal=${m}&limit=1`)),
    ]) as [Challenge | null, Board | null, Board | null, Board | null];
    if (mine !== token || !ch) return;
    const list = $('[data-winners]');
    list.replaceChildren();
    ([['wealth', w], ['speed', s], ['brevity', b]] as [Medal, Board | null][]).forEach(([m, bd]) => {
      const r = bd?.entries[0];
      if (!r) return;
      const li = el('li', 'winner');
      const pic = mosaicEl(r.mosaic, '5rem');
      if (pic) li.append(pic);
      const txt = el('div');
      const who = el('span');
      who.append(playerLink(r.login, r.displayName || r.login, r.tier));
      const dl = deltaEl(r.delta, r.rating);
      if (dl) who.append(dl);
      txt.append(el('strong', undefined, MEDALS[m].label), el('br'), who, el('br'), el('span', 'dim', medalValue(m, r.value)));
      li.append(txt);
      list.append(li);
    });
    if (!list.children.length) return;
    $('#yh').textContent = ch.number != null && ch.number > 0 ? `Yesterday's winners (daily #${ch.number})` : `Yesterday's winners (practice day)`;
    $('[data-yesterday]').hidden = false;
    yBoardId = id;
    yLoaded = '';
    if ((document.querySelector('[data-yboard]') as HTMLDetailsElement).open) void loadYBoard();
  }

  let yBoardId = '', yLoaded = '';
  /** Top 20 of the closed daily with each player's rating change. */
  async function loadYBoard() {
    if (!yBoardId || yLoaded === yBoardId) return;
    const id = yBoardId, body = $('[data-yrows]'), ys = $('[data-ystate]');
    ys.hidden = false; ys.textContent = 'Loading…';
    const b = await api<Board>(`/challenges/${id}/board?medal=wealth&limit=20`);
    if (id !== yBoardId) return;
    if (!b || !b.entries.length) { ys.textContent = b ? 'No entries.' : "The board can't be reached right now."; return; }
    yLoaded = id; ys.hidden = true;
    body.replaceChildren(...b.entries.map((r) => {
      const tr = el('tr');
      const farmer = el('td');
      farmer.append(farmerCell(r));
      tr.append(el('td', 'rank', String(r.rank)), farmer, el('td', 'num', medalValue('wealth', r.value)));
      return tr;
    }));
  }
  document.querySelector('[data-yboard]')!.addEventListener('toggle', () => { if ((document.querySelector('[data-yboard]') as HTMLDetailsElement).open) void loadYBoard(); });

  scopeTabs.forEach((t, i) => {
    t.addEventListener('click', () => { st.scope = t.dataset.scope as Scope; cursors = ['']; page = 0; void show(); });
    t.addEventListener('keydown', (ev) => {
      const d = ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      const n = scopeTabs[(i + d + scopeTabs.length) % scopeTabs.length]!;
      n.focus(); st.scope = n.dataset.scope as Scope; cursors = ['']; page = 0; void show();
    });
  });
  medalBtns.forEach((b) => b.addEventListener('click', () => { st.medal = b.dataset.medal as Medal; void show(); }));
  whoBtns.forEach((b) => b.addEventListener('click', () => { st.who = b.dataset.who!; void show(); }));
  authorBtns.forEach((b) => b.addEventListener('click', () => { st.author = b.dataset.author!; void show(); }));
  discBtns.forEach((b) => b.addEventListener('click', () => { st.disc = b.dataset.disc as Disc; cursors = ['']; page = 0; void show(); }));
  prevBtn.addEventListener('click', () => { if (page > 0) { page--; void show(); } });
  nextBtn.addEventListener('click', () => { if (cursors[page + 1]) { page++; void show(); } });
  endBtns.forEach((b) => b.addEventListener('click', () => { st.end = b.dataset.end!; void show(); }));
  void show();
</script>

<script>
  import { highlight } from '@tendril/lang/src/highlight.ts';

  // ---- published programs (C3) ----

  type Published = { entryId: string; displayName: string; login: string; netWorth: number; parTick: number | null; tokens: number | null; authorKind: 'human' | 'model'; model: string | null };
  const DAY = 86_400_000;
  const dayId = (ms: number) => `d-${new Date(ms).toISOString().slice(0, 10)}`;
  /** Same ISO-week id the server uses (s-YYYY-Www), for the week before this one. */
  function lastWeekId(ms: number) {
    const d = new Date(ms - 7 * DAY);
    const monday = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate()) - ((d.getUTCDay() + 6) % 7) * DAY;
    const thursday = new Date(monday + 3 * DAY);
    const year = thursday.getUTCFullYear();
    const week = Math.floor((thursday.getTime() - Date.UTC(year, 0, 1)) / (7 * DAY)) + 1;
    return `s-${year}-W${String(week).padStart(2, '0')}`;
  }
  const fmt = new Intl.NumberFormat('en-US');
  const picks = { daily: document.getElementById('pick-daily')!, season: document.getElementById('pick-season')! };
  const pState = document.querySelector<HTMLElement>('[data-programs-state]')!;
  const pList = document.querySelector<HTMLElement>('[data-programs]')!;
  const pFigure = document.querySelector<HTMLElement>('[data-program]')!;
  const pCaption = pFigure.querySelector<HTMLElement>('[data-program-caption]')!;
  const pCode = pFigure.querySelector<HTMLElement>('[data-program-code]')!;
  const reportBtn = pFigure.querySelector<HTMLButtonElement>('[data-report]')!;
  const reportState = pFigure.querySelector<HTMLElement>('[data-report-state]')!;
  let openEntry = '';
  let pToken = 0;
  reportBtn.addEventListener('click', async () => {
    if (!openEntry) return;
    reportBtn.disabled = true;
    reportState.textContent = 'Sending…';
    try {
      const res = await fetch(`/api/entries/${encodeURIComponent(openEntry)}/report`, {
        method: 'POST', headers: { 'content-type': 'application/json', 'x-tendril-client': '1' }, body: '{}',
      });
      reportState.textContent = res.ok ? 'Thanks, your report is in.'
        : res.status === 401 ? 'Sign in to report a program.'
        : res.status === 429 ? 'You have reported a lot today. Try again tomorrow.'
        : res.status === 422 ? 'You can\'t report your own program.'
        : 'The report did not go through. Try again later.';
      if (!res.ok) reportBtn.disabled = false;
    } catch { reportState.textContent = 'The report did not go through. Try again later.'; reportBtn.disabled = false; }
  });

  async function showPrograms(kind: 'daily' | 'season') {
    const mine = ++pToken;
    for (const [k, b] of Object.entries(picks)) b.setAttribute('aria-pressed', String(k === kind));
    pList.replaceChildren();
    pFigure.hidden = true;
    pState.hidden = false;
    pState.textContent = 'Loading…';
    const id = kind === 'daily' ? dayId(Date.now() - DAY) : lastWeekId(Date.now());
    try {
      const res = await fetch(`/api/challenges/${id}/sources?limit=20`, { headers: { accept: 'application/json' } });
      if (mine !== pToken) return;
      if (res.status === 404 || res.status === 403) { pState.textContent = 'Nothing has been published for this challenge.'; return; }
      if (!res.ok) throw new Error(String(res.status));
      const data = (await res.json()) as { entries: Published[] };
      if (mine !== pToken) return;
      if (!data.entries.length) { pState.textContent = 'Nobody has published a program for this challenge yet.'; return; }
      pState.hidden = true;
      const tiers = new Map<string, string>();
      try {
        const bd = await fetch(`/api/challenges/${id}/board?limit=100`, { headers: { accept: 'application/json' } });
        if (bd.ok) for (const r of ((await bd.json()) as { entries?: { entryId: string; tier?: { key: string } | null }[] }).entries ?? []) if (r.tier && /^[a-z]+$/.test(r.tier.key)) tiers.set(r.entryId, r.tier.key);
      } catch { /* names stay uncoloured */ }
      if (mine !== pToken) return;
      for (const e of data.entries) {
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button';
        const who = e.authorKind === 'model' && e.model ? `${e.displayName} (${e.model})` : e.displayName;
        const nm = document.createElement('span');
        nm.textContent = who;
        const tk = tiers.get(e.entryId);
        if (tk) nm.className = `tier-${tk}`;
        btn.append(nm, ` · ${fmt.format(e.netWorth)} coins${e.tokens === null ? '' : ` · ${fmt.format(e.tokens)} tokens`}`);
        btn.addEventListener('click', () => void readProgram(e, who, btn));
        li.append(btn);
        pList.append(li);
      }
    } catch {
      if (mine === pToken) pState.textContent = 'Programs can\'t be loaded right now. Try again in a minute.';
    }
  }

  async function readProgram(e: Published, who: string, btn: HTMLElement) {
    for (const b of pList.querySelectorAll('button')) b.removeAttribute('aria-current');
    btn.setAttribute('aria-current', 'true');
    openEntry = e.entryId;
    reportBtn.disabled = false;
    reportState.textContent = '';
    pFigure.hidden = false;
    pCaption.textContent = `${who}'s program`;
    pCode.textContent = 'Loading…';
    try {
      const res = await fetch(`/api/entries/${encodeURIComponent(e.entryId)}/source`, { headers: { accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      const data = (await res.json()) as { source: string; tokens: number | null };
      pCaption.textContent = `${who}'s program · ${fmt.format(e.netWorth)} coins${data.tokens === null ? '' : ` · ${fmt.format(data.tokens)} tokens`}`;
      pCode.replaceChildren(...highlight(data.source).map((span) => {
        if (span.kind === 'plain') return document.createTextNode(span.text);
        const el = document.createElement('span');
        el.className = `t-${span.kind}`;
        el.textContent = span.text;
        return el;
      }));
    } catch {
      pCode.textContent = 'This program can\'t be loaded right now.';
    }
  }
  picks.daily.addEventListener('click', () => void showPrograms('daily'));
  picks.season.addEventListener('click', () => void showPrograms('season'));
  void showPrograms('daily');
</script>

