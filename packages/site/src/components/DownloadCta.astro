---
// Main call to action. Before installers exist it leads with the browser version; after, with the visitor's OS.
import { PLATFORMS, RELEASE, released } from '../data/downloads';
const data = PLATFORMS.map((p) => ({ os: p.os, name: p.name, url: p.builds[0]?.url ?? null }));
---
<div class="cta" data-platforms={JSON.stringify(data)}>
  {released ? (
    <>
      <a class="btn primary" href="/download/" data-cta><span data-label>Download Tendril</span><small>v{RELEASE.version}</small></a>
      <a class="btn" href="/play/">Play in browser</a>
    </>
  ) : (
    <>
      <a class="btn primary" href="/play/">Play in browser</a>
      <a class="btn" href="/download/">Desktop app<small>Coming soon</small></a>
    </>
  )}
</div>
<script>
  for (const el of document.querySelectorAll<HTMLElement>('.cta')) {
    const a = el.querySelector<HTMLAnchorElement>('[data-cta]');
    if (!a) continue;
    const ua = navigator.userAgent;
    const os = /Windows/i.test(ua) ? 'windows' : /Mac OS X|Macintosh/i.test(ua) ? 'mac' : /Linux|X11/i.test(ua) && !/Android/i.test(ua) ? 'linux' : null;
    const list = JSON.parse(el.dataset.platforms ?? '[]') as { os: string; name: string; url: string | null }[];
    const p = list.find((x) => x.os === os);
    if (!p?.url) continue;
    a.querySelector('[data-label]')!.textContent = `Download for ${p.name}`;
    a.href = p.url;
  }
</script>
<style>
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
