---
import Base from './Base.astro';
import { DOCS_NAV, FLAT_NAV } from '../data/nav';
interface Props { frontmatter?: { title: string; description?: string }; title?: string; description?: string; headings?: { depth: number; slug: string; text: string }[] }
const fm = Astro.props.frontmatter ?? { title: Astro.props.title ?? '', description: Astro.props.description };
const headings = (Astro.props.headings ?? []).filter((h) => h.depth === 2);
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const i = FLAT_NAV.findIndex((n) => n.href === path);
const prev = i > 0 ? FLAT_NAV[i - 1] : undefined;
const next = i >= 0 && i < FLAT_NAV.length - 1 ? FLAT_NAV[i + 1] : undefined;
---
<Base title={fm.title} description={fm.description}>
  <div class="wrap docs">
    <aside class="side">
      <details class="side-toggle" open>
        <summary>Docs menu</summary>
        <nav aria-label="Docs">
          {DOCS_NAV.map((g) => (
            <div class="group">
              <p class="group-title">{g.title}</p>
              <ul>
                {g.items.map((it) => (
                  <li><a href={it.href} aria-current={it.href === path ? 'page' : undefined}>{it.title}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </details>
    </aside>
    <article class="prose">
      <h1>{fm.title}</h1>
      {fm.description && <p class="lede">{fm.description}</p>}
      <slot />
      <nav class="pager" aria-label="Pages">
        {prev ? <a href={prev.href} class="prev"><span>Previous</span>{prev.title}</a> : <span />}
        {next && <a href={next.href} class="next"><span>Next</span>{next.title}</a>}
      </nav>
    </article>
    {headings.length > 2 && (
      <aside class="toc" aria-label="On this page">
        <p class="group-title">On this page</p>
        <ul>{headings.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
      </aside>
    )}
  </div>
</Base>
<script>
  // Collapse the docs menu on narrow screens.
  const d = document.querySelector<HTMLDetailsElement>('.side-toggle');
  if (d && matchMedia('(max-width: 860px)').matches) d.open = false;
</script>
<style>
  .docs { display: grid; grid-template-columns: 14rem minmax(0, 1fr) 12rem; gap: 3rem; padding-top: 2.5rem; }
  .side nav, .toc { position: sticky; top: 5.5rem; }
  .side-toggle summary { display: none; }
  .group { margin-bottom: 1.75rem; }
  .group-title { margin: 0 0 0.5rem; font: 600 0.9rem var(--display); color: var(--dim); }
  .side ul, .toc ul { list-style: none; margin: 0; padding: 0; }
  .side li a { display: block; padding: 0.3rem 0 0.3rem 0.85rem; border-left: 2px solid var(--line); color: var(--ink); text-decoration: none; font-size: 0.97rem; }
  .side li a:hover { border-left-color: var(--dim); }
  .side li a[aria-current='page'] { border-left-color: var(--leaf); color: var(--leaf); font-weight: 700; }
  .toc li a { display: block; padding: 0.2rem 0; color: var(--dim); text-decoration: none; font-size: 0.9rem; }
  .toc li a:hover { color: var(--ink); }
  .pager { display: flex; justify-content: space-between; gap: 1rem; margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .pager a { display: flex; flex-direction: column; text-decoration: none; font: 650 1.1rem var(--display); }
  .pager span { font: 400 0.85rem var(--body); color: var(--dim); }
  .pager .next { text-align: right; margin-left: auto; }
  @media (max-width: 1180px) { .docs { grid-template-columns: 13rem minmax(0, 1fr); } .toc { display: none; } }
  @media (max-width: 860px) {
    .docs { grid-template-columns: 1fr; gap: 1rem; padding-top: 1.25rem; }
    .side nav { position: static; padding-top: 1rem; }
    .side-toggle { border: 1px solid var(--line); border-radius: 8px; padding: 0.65rem 0.9rem; }
    .side-toggle summary { display: list-item; cursor: pointer; font: 600 1rem var(--display); }
  }
</style>
<style is:global>
  .prose { max-width: 46rem; min-width: 0; }
  .prose .lede { font-size: 1.2rem; color: var(--dim); margin: 0.9rem 0 2rem; }
  .prose h2 { margin: 3rem 0 0.9rem; padding-top: 0.5rem; }
  .prose h3 { margin: 2.25rem 0 0.6rem; }
  .prose h3 code { font-size: 0.9em; background: none; padding: 0; }
  .prose p, .prose ul, .prose ol { margin: 0 0 1.1rem; }
  .prose li { margin-bottom: 0.35rem; }
  .prose pre { margin: 0 0 1.4rem; }
  .prose table { margin: 0 0 1.5rem; }
  .prose blockquote { margin: 0 0 1.4rem; padding: 0.85rem 1.1rem; border-left: 3px solid var(--wheat); background: var(--panel); border-radius: 0 8px 8px 0; }
  .prose blockquote p:last-child { margin: 0; }
  .prose h2 a, .prose h3 a { color: inherit; text-decoration: none; }
</style>
