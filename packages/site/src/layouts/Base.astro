---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title, description = 'Tendril is an endless farming game you play by writing Sprout, a plain-English programming language. Script your bots, grow your land without limit, and climb a leaderboard that replays every move.' } = Astro.props;
const fullTitle = title ? `${title} | Tendril` : 'Tendril: a farm you grow by writing code';
const path = Astro.url.pathname;
const here = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));
// Social card drawn at build time by scripts/og.mjs (keep this path rule in step with ogPath() there).
const canonical = new URL(path, Astro.site);
const signIn = `/api/auth/github?return=${encodeURIComponent(path)}`;
const ogImage = new URL(`/og/${/^\/404/.test(path) ? 'index' : path.replace(/^\/+|\/+$/g, '') || 'index'}.png`, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tendril" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#2f6e35" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,400;0,700;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=JetBrains+Mono:wght@400;600&display=swap" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="Tendril home">
          <img src="/favicon.svg" alt="" width="28" height="28" />
          <span>Tendril</span>
        </a>
        <nav aria-label="Main">
          <a href="/docs/" aria-current={here('/docs') && !here('/docs/reference') ? 'page' : undefined}>Docs</a>
          <a href="/docs/reference/" aria-current={here('/docs/reference') ? 'page' : undefined}>Reference</a>
          <a href="/leaderboard/" aria-current={here('/leaderboard') ? 'page' : undefined}>Leaderboard</a>
          <a href="/season-1/" aria-current={here('/season-1') ? 'page' : undefined}>Season 1</a>
          <a data-me href={signIn}>Sign in</a>
          <details class="menu">
            <summary>Menu</summary>
            <div class="menu-panel">
              <a href="/docs/" aria-current={here('/docs') && !here('/docs/reference') ? 'page' : undefined}>Docs</a>
              <a href="/docs/reference/" aria-current={here('/docs/reference') ? 'page' : undefined}>Reference</a>
              <a href="/leaderboard/" aria-current={here('/leaderboard') ? 'page' : undefined}>Leaderboard</a>
              <a href="/season-1/" aria-current={here('/season-1') ? 'page' : undefined}>Season 1</a>
              <a href="/docs/models/">AI models</a>
              <a href="/play/">Play in browser</a>
              <a data-me href={signIn}>Sign in</a>
            </div>
          </details>
          <a class="btn primary small" href="/download/">Download</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <script>
      // Signed in: the header links to your own profile. Signed out: it links to GitHub sign-in.
      fetch('/api/me', { headers: { accept: 'application/json' } })
        .then((r) => (r.ok ? r.json() : null))
        .then((d: { profile?: { login?: string } } | null) => {
          const login = d?.profile?.login;
          if (!login) return;
          document.querySelectorAll<HTMLAnchorElement>('[data-me]').forEach((a) => {
            a.href = `/u/?login=${encodeURIComponent(login)}`;
            a.textContent = 'My profile';
          });
        })
        .catch(() => {});
    </script>
    <footer class="site-foot">
      <div class="wrap foot">
        <p>Tendril is a farming game you play by writing code. Your programs run on your machine; the server only checks the moves.</p>
        <nav aria-label="Footer">
          <a href="/docs/">Getting started</a>
          <a href="/docs/how-to-play/">How the farm works</a>
          <a href="/docs/reference/">Sprout reference</a>
          <a href="/leaderboard/">Leaderboard</a>
          <a href="/season-1/">Season 1</a>
          <a href="/play/">Play in browser</a>
          <a href="/docs/leaderboard/">Fair play</a>
          <a href="/download/">Download</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
<style>
  .skip { position: absolute; left: -999px; top: 0; }
  .skip:focus { left: 1rem; top: 1rem; z-index: 10; background: var(--paper); padding: 0.5rem 0.75rem; }
  .site-head { position: sticky; top: 0; z-index: 5; background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 4rem; gap: 1rem; }
  .brand { display: flex; align-items: center; gap: 0.55rem; color: var(--ink); text-decoration: none; font: 700 1.35rem var(--display); letter-spacing: -0.02em; }
  .site-head nav { display: flex; align-items: center; gap: clamp(0.75rem, 3vw, 1.75rem); }
  .site-head nav a:not(.btn) { color: var(--ink); text-decoration: none; font-weight: 700; font-size: 0.98rem; }
  .site-head nav a[aria-current='page'] { color: var(--leaf); }
  .site-head nav a:not(.btn):hover { color: var(--leaf); }
  .btn.small { padding: 0.45rem 0.95rem; font-size: 0.95rem; }
  .site-foot { border-top: 1px solid var(--line); margin-top: 6rem; padding-block: 2.5rem 3rem; color: var(--dim); font-size: 0.95rem; }
  .foot { display: flex; flex-wrap: wrap; gap: 1.5rem 3rem; justify-content: space-between; }
  .foot p { max-width: 34rem; margin: 0; }
  .foot nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
  .foot a { color: var(--dim); }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; cursor: pointer; font-weight: 700; font-size: 0.98rem; padding: 0.4rem 0.2rem; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary::after { content: ' ▾'; }
  .menu[open] summary::after { content: ' ▴'; }
  .menu-panel { position: absolute; right: 0; top: calc(100% + 0.5rem); min-width: 12rem; display: grid; background: var(--paper); border: 1px solid var(--line); border-radius: 12px; padding: 0.4rem; box-shadow: 0 8px 24px rgb(0 0 0 / 0.12); }
  .site-head nav .menu-panel a:not(.btn) { padding: 0.6rem 0.75rem; border-radius: 8px; }
  .site-head nav .menu-panel a:hover { background: color-mix(in srgb, var(--leaf) 10%, transparent); }
  @media (max-width: 640px) {
    .site-head nav > a:not(.btn) { display: none; }
    .menu { display: block; }
  }
</style>
<script>
  // The phone menu is a plain <details>; close it on Escape or a click elsewhere.
  const menu = document.querySelector<HTMLDetailsElement>('.site-head .menu');
  if (menu) {
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')?.focus(); } });
    document.addEventListener('click', (e) => { if (menu.open && !menu.contains(e.target as Node)) menu.open = false; });
  }
</script>
